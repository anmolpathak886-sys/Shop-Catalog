# Local MongoDB. For Atlas, replace this with your Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/shop_catalog
PORT=5001
# Comma-separated frontend origins allowed to call the API.
# For local development, the defaults in server.js allow Vite on localhost:5173.
# In production, set this to your frontend origin, without a trailing slash.
# CLIENT_ORIGIN=https://shop.example.com
